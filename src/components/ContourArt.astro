---
// Original, deterministic illustration used when an article has no licensed
// hero image: a contour map whose shape is seeded by the article id, drawn in
// the article's content-type tone. Decorative, so hidden from assistive tech.
interface Props {
  seed: string;
  tone: string;
  ratio?: '16/9' | '4/3' | '3/2' | '1/1';
  class?: string;
}
const { seed, tone, ratio = '3/2', class: className } = Astro.props;

function hash(s: string) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
function rng(seedNum: number) {
  let t = seedNum;
  return () => {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

const [rw, rh] = ratio.split('/').map(Number);
const W = 600;
const H = Math.round((W * rh) / rw);
const rand = rng(hash(seed));

// One or two peaks, each a stack of wobbly closed contours.
const peaks = Array.from({ length: rand() > 0.45 ? 2 : 1 }, () => ({
  cx: W * (0.25 + rand() * 0.5),
  cy: H * (0.3 + rand() * 0.45),
  base: Math.min(W, H) * (0.55 + rand() * 0.3),
  harmonics: Array.from({ length: 4 }, (_, i) => ({
    k: i + 2,
    amp: (0.05 + rand() * 0.11) / (i + 1),
    phase: rand() * Math.PI * 2,
  })),
  stretch: 1.15 + rand() * 0.6,
}));

const LEVELS = 11;
const paths: { d: string; level: number }[] = [];
for (const p of peaks) {
  for (let l = 0; l < LEVELS; l++) {
    const scale = 1 - l / LEVELS;
    const pts: string[] = [];
    const N = 96;
    for (let i = 0; i <= N; i++) {
      const a = (i / N) * Math.PI * 2;
      let r = 1;
      for (const h of p.harmonics) r += h.amp * Math.sin(h.k * a + h.phase + l * 0.18);
      const R = p.base * scale * r;
      const x = p.cx + Math.cos(a) * R * p.stretch;
      const y = p.cy + Math.sin(a) * R * 0.62;
      pts.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`);
    }
    paths.push({ d: pts.join(' ') + 'Z', level: l });
  }
}
const summit = peaks[0];
---
<div class:list={['contour', className]} style={`--bg: var(--art-${tone}); --dot: var(--art-dot-${tone}); aspect-ratio: ${ratio};`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    {paths.map(({ d, level }) => (
      <path d={d} fill="none" stroke={level === LEVELS - 1 ? 'var(--dot)' : 'currentColor'} stroke-width={level % 5 === 0 ? 1.5 : 0.85} opacity={0.16 + (level / LEVELS) * 0.6} />
    ))}
    <circle cx={summit.cx} cy={summit.cy} r="34" fill="var(--dot)" opacity="0.12" />
    <circle cx={summit.cx} cy={summit.cy} r="6" fill="var(--dot)" />
  </svg>
</div>
<style>
  .contour {
    background:
      radial-gradient(120% 90% at 85% 10%, rgb(255 255 255 / 0.10), transparent 55%),
      var(--bg);
    color: var(--art-line);
    overflow: hidden;
    border-radius: var(--radius-m);
  }
  .contour svg { width: 100%; height: 100%; }
</style>
