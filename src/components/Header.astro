---
import Wordmark from './Wordmark.astro';
import { nav } from '../config/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="home" href="/" aria-label="The Research Frontier, home"><Wordmark /></a>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {nav.filter((n) => n.href !== '/').map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="mobile-only"><a href="/newsletter/">Subscribe to the newsletter</a></li>
      </ul>
    </nav>
    <div class="tools">
      <a class="tool" href="/search/" aria-label="Search">
        <svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12.6 12.6 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <button class="tool theme" type="button" data-theme-toggle aria-pressed="false" hidden>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3a7 7 0 1 0 0 14Z" fill="currentColor"/><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span class="visually-hidden">Dark theme</span>
      </button>
      <a class="button subscribe" href="/newsletter/">Subscribe</a>
      <button class="tool menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" hidden>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    toggle.hidden = false;
    document.documentElement.classList.add('js');
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      navEl.classList.toggle('is-open', !open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        navEl.classList.remove('is-open');
        toggle.focus();
      }
    });
  }
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', scrollY > 4);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn) {
    const root = document.documentElement;
    const isDark = () =>
      root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const sync = () => themeBtn.setAttribute('aria-pressed', String(isDark()));
    themeBtn.hidden = false;
    sync();
    themeBtn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      sync();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .site-header.scrolled { border-bottom-color: var(--rule); }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    min-height: 4.25rem;
  }
  .home { text-decoration: none; min-width: 0; order: 1; padding-block: 0.75rem; }
  .tools { display: flex; align-items: center; gap: 0.125rem; order: 2; margin-left: auto; flex: none; }
  .nav { order: 3; flex-basis: 100%; }
  .tool {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 2.75rem; min-width: 2.75rem; padding: 0 0.5rem;
    border: 0; border-radius: 999px; background: transparent; color: var(--ink);
    font: 600 var(--step-0) / 1 var(--font-sans); text-decoration: none; cursor: pointer;
  }
  .tool:hover { background: var(--panel); color: var(--ink); }
  .tool[hidden] { display: none; }
  .subscribe { margin-left: 0.35rem; }

  .nav ul { list-style: none; margin: 0; padding: 0 0 0.25rem; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .nav a {
    display: inline-block; padding: 0.55rem 0;
    color: var(--ink); font-weight: 500; font-size: 0.975rem; text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover { color: var(--accent); }
  .nav a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }

  @media (min-width: 90rem) {
    .nav { order: 2; flex-basis: auto; margin-left: 0.75rem; }
    .bar :global(.wordmark) { font-size: 1.2rem; }
    .subscribe { padding-inline: 1rem; }
    .nav ul { flex-wrap: nowrap; }
    .nav ul { padding: 0; white-space: nowrap; }
    .nav a { padding: 1.4rem 0 1.25rem; }
    .tools { order: 3; }
  }
  @media (max-width: 23.5rem) {
    .bar :global(.wordmark .the) { display: none; }
  }
  @media (min-width: 48rem) {
    .mobile-only { display: none; }
    .menu-toggle { display: none !important; }
  }
  @media (max-width: 47.99rem) {
    .bar :global(.wordmark) { font-size: 1.02rem; }
    .bar { column-gap: 0.25rem; }
    .tools { gap: 0; }
    .bar :global(.wordmark .mark) { width: 1.6rem; height: 1.6rem; }
    .subscribe { display: none; }
    :global(html.js) .nav { display: none; }
    :global(html.js) .nav.is-open { display: block; }
    .nav ul { flex-direction: column; gap: 0; padding-bottom: var(--space-s); }
    .nav li + li { border-top: var(--border); }
    .nav a { display: block; padding: 0.85rem 0; border-bottom: 0; }
  }
</style>
