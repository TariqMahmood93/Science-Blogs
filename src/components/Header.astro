---
// Site navigation. On wide screens it is a sticky sidebar on the left;
// on narrow screens a top bar opens it as a slide-out drawer.
import Wordmark from './Wordmark.astro';
import NavIcon from './NavIcon.astro';
import { nav, site } from '../config/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const explore = nav.filter((n) => n.href !== '/about/');
const about = nav.filter((n) => n.href === '/about/');
---
<header class="topbar">
  <a class="tb-home" href="/" aria-label="The Research Frontier, home"><Wordmark compact /></a>
  <div class="tb-tools">
    <a class="icon-btn" href="/search/" aria-label="Search"><NavIcon name="search" /></a>
    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="sidebar" aria-label="Open menu" hidden>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<div class="scrim" data-scrim hidden></div>

<aside id="sidebar" class="sidebar" aria-label="Site">
  <div class="sb-inner">
    <div class="sb-top">
      <a class="sb-home" href="/" aria-label="The Research Frontier, home"><Wordmark /></a>
      <button class="icon-btn sb-close" type="button" aria-label="Close menu" data-close hidden>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>

    <a class="sb-search" href="/search/">
      <NavIcon name="search" />
      <span>Search articles</span>
    </a>

    <nav class="sb-nav" aria-label="Main">
      <p class="sb-label" id="sb-explore">Explore</p>
      <ul aria-labelledby="sb-explore">
        {explore.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <NavIcon name={item.icon} /><span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sb-label" id="sb-pub">Publication</p>
      <ul aria-labelledby="sb-pub">
        {about.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <NavIcon name={item.icon} /><span>{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="/editorial-policy/" aria-current={isCurrent('/editorial-policy/') ? 'page' : undefined}>
            <NavIcon name="policy" /><span>Editorial policy</span>
          </a>
        </li>
        <li>
          <a href="/submit/" aria-current={isCurrent('/submit/') ? 'page' : undefined}>
            <NavIcon name="pen" /><span>Write for us</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="sb-bottom">
      <div class="sb-promo">
        <p class="promo-t">The monthly letter</p>
        <p class="promo-d">New articles and one open question, {site.newsletter.cadence.replace('one email ', '')}.</p>
        <a class="button sb-sub" href="/newsletter/"><NavIcon name="mail" />Subscribe</a>
      </div>
      <button class="theme" type="button" data-theme-toggle aria-pressed="false" hidden>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3a7 7 0 1 0 0 14Z" fill="currentColor"/><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Dark theme</span>
      </button>
    </div>
  </div>
</aside>

<script>
  const root = document.documentElement;
  root.classList.add('js');
  const sidebar = document.getElementById('sidebar')!;
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-close]')!;
  const scrim = document.querySelector<HTMLElement>('[data-scrim]')!;
  const mq = matchMedia('(min-width: 64rem)');
  toggle.hidden = false;
  closeBtn.hidden = false;

  const setOpen = (open: boolean, focus = true) => {
    sidebar.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    scrim.hidden = !open;
    document.body.classList.toggle('drawer-open', open);
    // When the drawer is closed on small screens its links must not be reachable by keyboard.
    if (!mq.matches) sidebar.inert = !open;
    if (open && focus) sidebar.querySelector<HTMLElement>('a, button')?.focus();
    if (!open && focus) toggle.focus();
  };
  const sync = () => {
    if (mq.matches) { sidebar.inert = false; setOpen(false, false); }
    else sidebar.inert = !sidebar.classList.contains('is-open');
  };
  toggle.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  scrim.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar.classList.contains('is-open')) setOpen(false);
  });
  mq.addEventListener('change', sync);
  sync();

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn) {
    const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const syncTheme = () => themeBtn.setAttribute('aria-pressed', String(isDark()));
    themeBtn.hidden = false;
    syncTheme();
    themeBtn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      syncTheme();
    });
  }
</script>

<style>
  /* ---------- Sidebar (wide screens) ---------- */
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    border-right: 1px solid var(--rule);
    background: var(--paper);
    z-index: 50;
  }
  .sb-inner {
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-m) var(--space-s) var(--space-m) var(--space-m);
    scrollbar-width: thin;
  }
  .sb-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2xs); }
  .sb-home { text-decoration: none; }
  .sb-home :global(.wordmark) { font-size: 1.12rem; white-space: normal; }

  .sb-search {
    display: flex; align-items: center; gap: 0.6rem;
    min-height: 2.75rem; padding: 0 0.85rem;
    border: 1px solid var(--rule); border-radius: 999px; background: var(--panel);
    color: var(--ink-2); text-decoration: none; font-size: var(--step--1);
  }
  .sb-search:hover { border-color: var(--rule-strong); color: var(--ink); }

  .sb-label { font-size: 0.78rem; font-weight: 600; color: var(--ink-2); margin: var(--space-xs) 0 0.35rem 0.75rem; }
  .sb-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sb-nav a {
    display: flex; align-items: center; gap: 0.75rem;
    min-height: 2.6rem; padding: 0.45rem 0.75rem;
    border-radius: 10px;
    color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.97rem;
  }
  .sb-nav a :global(.navicon) { color: var(--ink-2); }
  .sb-nav a:hover { background: var(--panel); }
  .sb-nav a[aria-current='page'] { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-weight: 600; }
  .sb-nav a[aria-current='page'] :global(.navicon) { color: var(--accent); }

  .sb-bottom { margin-top: auto; display: grid; gap: var(--space-s); }
  .sb-promo { padding: var(--space-s); border-radius: var(--radius-m); background: var(--panel); display: grid; gap: 0.4rem; }
  .promo-t { font-weight: 650; }
  .promo-d { font-size: var(--step--1); color: var(--ink-2); line-height: 1.45; }
  .sb-sub { margin-top: 0.35rem; width: 100%; }
  .theme {
    display: flex; align-items: center; gap: 0.6rem; min-height: 2.6rem; padding: 0 0.75rem;
    border: 0; border-radius: 10px; background: transparent; color: var(--ink-2);
    font: 500 var(--step--1) / 1 var(--font-sans); cursor: pointer;
  }
  .theme:hover { background: var(--panel); color: var(--ink); }
  .theme[hidden] { display: none; }

  .icon-btn {
    display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem;
    border: 0; border-radius: 999px; background: transparent; color: var(--ink); cursor: pointer;
  }
  .icon-btn:hover { background: var(--panel); }
  .icon-btn[hidden] { display: none; }

  /* ---------- Top bar + drawer (narrow screens) ---------- */
  .topbar { display: none; }
  .scrim { display: none; }

  @media (max-width: 63.99rem) {
    .topbar {
      position: sticky; top: 0; z-index: 40;
      display: flex; align-items: center; justify-content: space-between; gap: var(--space-2xs);
      padding: 0.5rem var(--gutter);
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: saturate(1.4) blur(10px);
      border-bottom: 1px solid var(--rule);
    }
    .tb-home { text-decoration: none; min-width: 0; }
    .tb-tools { display: flex; align-items: center; }

    /* Without JavaScript the sidebar simply sits above the content. */
    .sidebar { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--rule); }
    .sb-bottom { margin-top: 0; }

    :global(html.js) .sidebar {
      position: fixed; inset: 0 auto 0 0;
      width: min(20rem, 86vw); height: 100dvh;
      border-right: 1px solid var(--rule);
      transform: translateX(-100%);
      transition: transform 0.25s ease, visibility 0s linear 0.25s;
      visibility: hidden;
      box-shadow: 0 0 40px rgb(0 0 0 / 0.2);
    }
    :global(html.js) .sidebar.is-open { transform: none; visibility: visible; transition: transform 0.25s ease; }
    :global(html.js) .sb-bottom { margin-top: auto; }
    .scrim:not([hidden]) { display: block; position: fixed; inset: 0; z-index: 45; background: rgb(0 0 0 / 0.4); }
    :global(body.drawer-open) { overflow: hidden; }
  }
  @media (min-width: 64rem) {
    .sb-close { display: none !important; }
    .menu-toggle { display: none !important; }
  }
</style>
