---
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="callout">
  {title && <p class="title">{title}</p>}
  <slot />
</aside>
<style>
  .callout { margin-block: var(--space-m); padding: var(--space-s) var(--space-m); border: var(--border); border-radius: var(--radius-m); }
  .title { font: 600 var(--step-0) / 1.3 var(--font-sans); margin-bottom: var(--space-2xs); }
  .callout :global(p) { margin: 0; }
  .callout :global(p + p) { margin-top: var(--space-xs); }
</style>
