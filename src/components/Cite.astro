---
// Inline citation. Write <Cite id="key" /> in MDX; the number is filled in at build time.
interface Props { id: string; n?: string; occurrence?: string; verified?: string; summary?: string }
const { id, n = '?', occurrence = '1', summary = '' } = Astro.props;
---
<sup class="cite"><a id={`cite-${id}-${occurrence}`} href={`#ref-${id}`} title={summary} aria-label={`Reference ${n}`}>[{n}]</a></sup>
<style>
  .cite { line-height: 0; font-family: var(--font-sans); font-size: 0.7em; font-weight: 600; }
  .cite a { text-decoration: none; padding: 0.2em 0.1em; }
  .cite a:hover { text-decoration: underline; }
</style>
