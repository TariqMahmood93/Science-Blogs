---
// Ideas branching out from a single question; one path is tested and lights up.
type N = { x: number; y: number };
const levels: N[][] = [
  [{ x: 330, y: 450 }],
  [{ x: 600, y: 300 }, { x: 600, y: 600 }],
  [{ x: 870, y: 210 }, { x: 870, y: 380 }, { x: 870, y: 520 }, { x: 870, y: 690 }],
  Array.from({ length: 8 }, (_, i) => ({ x: 1140, y: 160 + i * 83 })),
];
const edges: [N, N][] = [];
for (let l = 1; l < levels.length; l++) levels[l].forEach((n, i) => edges.push([levels[l - 1][Math.floor(i / 2)], n]));
const lit = [levels[0][0], levels[1][1], levels[2][2], levels[3][5]];
const curve = (a: N, b: N) => `C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`;
const litPath = `M${lit[0].x} ${lit[0].y} ` + lit.slice(1).map((n, i) => curve(lit[i], n)).join(' ');
const end = lit[3];
---
<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" class="hyp">
  <g class="edges">
    {edges.map(([a, b]) => <path d={`M${a.x} ${a.y} C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`} />)}
  </g>
  <path class="lit" d={litPath} pathLength="100" />
  <g class="nodes">
    {levels.flat().map((n) => <circle cx={n.x} cy={n.y} r="11" />)}
  </g>
  <g class="litnodes">
    {lit.map((n, i) => <circle cx={n.x} cy={n.y} r="13" style={`animation-delay:${i * 0.5}s`} />)}
  </g>
  <g class="bulb" transform={`translate(${end.x + 150} ${end.y})`}>
    <circle class="glow" r="70" />
    <path d="M-34 -10 C -34 -52 34 -52 34 -10 C 34 14 18 22 16 40 L -16 40 C -18 22 -34 14 -34 -10 Z" />
    <path d="M-14 56 L14 56 M-10 70 L10 70" />
  </g>
  <text x="330" y="380" class="q" text-anchor="middle">?</text>
</svg>
<style>
  .hyp { width: 100%; height: 100%; }
  .edges path { fill: none; stroke: var(--art-line); stroke-width: 2.5; opacity: 0.32; }
  .nodes circle { fill: var(--bg); stroke: var(--art-line); stroke-width: 3; opacity: 0.7; }
  .lit { fill: none; stroke: var(--dot); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 100; stroke-dashoffset: 100; filter: drop-shadow(0 0 10px var(--dot)); animation: light 5s ease-in-out infinite; }
  .litnodes circle { fill: var(--dot); filter: drop-shadow(0 0 10px var(--dot)); animation: pop 5s ease-in-out infinite; opacity: 0.3; }
  .bulb path { fill: none; stroke: var(--dot); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .bulb .glow { fill: var(--dot); opacity: 0; filter: blur(24px); animation: glow 5s ease-in-out infinite; }
  .q { fill: var(--art-line); font: 700 72px/1 system-ui, sans-serif; opacity: 0.8; }
  @keyframes light { 0% { stroke-dashoffset: 100; } 45%, 80% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
  @keyframes pop { 0%, 10% { opacity: 0.3; } 30%, 80% { opacity: 1; } 100% { opacity: 0.3; } }
  @keyframes glow { 0%, 40% { opacity: 0; } 55%, 80% { opacity: 0.55; } 100% { opacity: 0; } }
</style>
