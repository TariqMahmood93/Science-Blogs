---
// A model's prediction with a confidence band that widens where data are sparse.
const W = 1600;
const f = (x: number) => 470 - 130 * Math.sin((x - 250) / 230) - (x - 250) * 0.06;
const spread = (x: number) => 34 + 120 * Math.max(0, (x - 900) / 600) ** 1.6 + 60 * Math.exp(-(((x - 520) / 90) ** 2));
const xs = Array.from({ length: 61 }, (_, i) => 250 + i * 18.5);
const line = 'M' + xs.map((x) => `${x.toFixed(0)} ${f(x).toFixed(1)}`).join(' L');
const band = 'M' + xs.map((x) => `${x.toFixed(0)} ${(f(x) - spread(x)).toFixed(1)}`).join(' L') + ' L' + [...xs].reverse().map((x) => `${x.toFixed(0)} ${(f(x) + spread(x)).toFixed(1)}`).join(' L') + ' Z';
const pts = [300, 360, 410, 640, 700, 760, 820, 880, 950, 1040].map((x, i) => ({ x, y: f(x) + ((i * 37) % 50) - 25, e: 18 + (i % 3) * 10 }));
---
<svg viewBox={`0 0 ${W} 900`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" class="unc">
  <g class="axes">
    <line x1="230" y1="780" x2="1420" y2="780" />
    <line x1="230" y1="780" x2="230" y2="140" />
    {Array.from({ length: 6 }, (_, i) => <line class="tick" x1="230" y1={180 + i * 100} x2="1420" y2={180 + i * 100} />)}
  </g>
  <path class="band" d={band} />
  <path class="pred" d={line} pathLength="100" />
  <g class="pts">
    {pts.map((p, i) => (
      <g style={`animation-delay:${i * 0.35}s`}>
        <line x1={p.x} y1={p.y - p.e} x2={p.x} y2={p.y + p.e} />
        <circle cx={p.x} cy={p.y} r="9" />
      </g>
    ))}
  </g>
  <g class="qmark" transform="translate(1300 230)">
    <circle r="44" />
    <text y="18" text-anchor="middle">?</text>
  </g>
</svg>
<style>
  .unc { width: 100%; height: 100%; }
  .axes line { stroke: var(--art-line); stroke-width: 2.5; opacity: 0.6; }
  .axes .tick { stroke-width: 1; opacity: 0.1; }
  .band { fill: var(--dot); opacity: 0.18; transform-box: fill-box; transform-origin: center; animation: breathe 5s ease-in-out infinite; }
  .pred { fill: none; stroke: var(--dot); stroke-width: 5; stroke-linecap: round; filter: drop-shadow(0 0 8px var(--dot)); stroke-dasharray: 100; animation: draw 7s ease-in-out infinite; }
  .pts line { stroke: var(--art-line); stroke-width: 2.5; opacity: 0.7; }
  .pts circle { fill: var(--art-line); }
  .pts g { animation: twinkle 3.5s ease-in-out infinite; }
  .qmark circle { fill: none; stroke: var(--dot); stroke-width: 3; stroke-dasharray: 8 7; animation: spin 18s linear infinite; transform-box: fill-box; transform-origin: center; }
  .qmark text { fill: var(--dot); font: 700 54px/1 system-ui, sans-serif; }
  @keyframes breathe { 0%, 100% { transform: scaleY(0.92); opacity: 0.14; } 50% { transform: scaleY(1.08); opacity: 0.24; } }
  @keyframes draw { 0% { stroke-dashoffset: 100; } 35%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -100; } }
  @keyframes twinkle { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
