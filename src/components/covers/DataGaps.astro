---
// A data table where some rows have far more gaps than others; gaps are filled in and fade, over and over.
const cols = 11, rows = 7;
const cw = 82, ch = 56, x0 = 330, y0 = 230;
// Rows 4 and 5 (one group) are missing far more often than the rest.
const missing = new Set(['0-3', '1-7', '3-9', '4-1', '4-3', '4-4', '4-6', '4-8', '4-10', '5-0', '5-2', '5-5', '5-6', '5-9', '6-4']);
---
<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" class="data">
  <g class="groups">
    <rect x="270" y={y0} width="10" height={ch * 4 - 10} rx="5" class="ga" />
    <rect x="270" y={y0 + ch * 4} width="10" height={ch * 2 - 10} rx="5" class="gb" />
    <rect x="270" y={y0 + ch * 6} width="10" height={ch - 10} rx="5" class="ga" />
  </g>
  <g class="head">
    {Array.from({ length: cols }, (_, c) => <rect x={x0 + c * cw} y={y0 - 50} width={cw - 30} height="10" rx="5" />)}
  </g>
  <g class="cells">
    {Array.from({ length: rows }, (_, r) =>
      Array.from({ length: cols }, (_, c) => {
        const key = `${r}-${c}`;
        const x = x0 + c * cw, y = y0 + r * ch;
        return missing.has(key) ? (
          <g class="gap">
            <rect class="hole" x={x} y={y} width={cw - 12} height={ch - 12} rx="8" />
            <rect class="fill" x={x} y={y} width={cw - 12} height={ch - 12} rx="8" style={`animation-delay:${((r * 7 + c * 3) % 10) * 0.45}s`} />
          </g>
        ) : (
          <rect class="val" x={x} y={y} width={cw - 12} height={ch - 12} rx="8" style={`opacity:${0.18 + ((r * 5 + c * 7) % 6) * 0.07}`} />
        );
      }),
    )}
  </g>
  <g class="bars">
    <rect x="1290" y="560" width="46" height="110" rx="6" class="ga" />
    <rect x="1350" y="610" width="46" height="60" rx="6" class="gb bar-b" />
    <line x1="1270" y1="672" x2="1420" y2="672" />
  </g>
</svg>
<style>
  .data { width: 100%; height: 100%; }
  .head rect { fill: var(--art-line); opacity: 0.35; }
  .val { fill: var(--art-line); }
  .hole { fill: none; stroke: var(--dot); stroke-width: 2.5; stroke-dasharray: 8 7; opacity: 0.9; }
  .fill { fill: var(--dot); opacity: 0; animation: impute 4.5s ease-in-out infinite; }
  .ga { fill: var(--art-line); opacity: 0.6; }
  .gb { fill: var(--dot); }
  .bars line { stroke: var(--art-line); stroke-width: 2; opacity: 0.5; }
  .bar-b { transform-box: fill-box; transform-origin: bottom; animation: grow 4.5s ease-in-out infinite; }
  @keyframes impute { 0%, 20% { opacity: 0; } 45%, 65% { opacity: 0.75; } 90%, 100% { opacity: 0; } }
  @keyframes grow { 0%, 20% { transform: scaleY(1); } 45%, 65% { transform: scaleY(1.7); } 90%, 100% { transform: scaleY(1); } }
</style>
