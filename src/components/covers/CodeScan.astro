---
// A code editor being scanned line by line; one line is flagged as a vulnerability.
const lines = [
  [0, 260], [40, 380], [40, 300], [80, 420], [80, 220], [40, 340], [0, 180],
  [0, 300], [40, 460], [80, 360], [80, 280], [40, 200], [0, 240],
];
const flagged = 8;
const top = 260, gap = 34;
---
<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" class="code">
  <g class="grid">
    {Array.from({ length: 17 }, (_, i) => <line x1={i * 100} y1="0" x2={i * 100} y2="900" />)}
    {Array.from({ length: 10 }, (_, i) => <line x1="0" y1={i * 100} x2="1600" y2={i * 100} />)}
  </g>
  <g class="window">
    <rect x="330" y="170" width="820" height="590" rx="22" />
    <line x1="330" y1="222" x2="1150" y2="222" />
    <circle cx="364" cy="196" r="7" /><circle cx="390" cy="196" r="7" /><circle cx="416" cy="196" r="7" />
  </g>
  <g class="gutter">
    {lines.map((_, i) => <rect x="370" y={top + i * gap} width="22" height="10" rx="5" />)}
  </g>
  <rect class="flag-bg" x="352" y={top + flagged * gap - 12} width="776" height="34" rx="8" />
  <g class="lines">
    {lines.map(([indent, w], i) => (
      <rect class:list={{ hot: i === flagged }} x={420 + indent} y={top + i * gap} width={w} height="10" rx="5" />
    ))}
  </g>
  <g class="beam">
    <rect x="340" y="232" width="800" height="70" />
    <line x1="340" y1="302" x2="1140" y2="302" />
  </g>
  <g class="lens">
    <circle cx="1210" cy={top + flagged * gap + 5} r="92" />
    <line x1="1276" y1={top + flagged * gap + 71} x2="1350" y2={top + flagged * gap + 145} />
    <circle class="ping" cx="1210" cy={top + flagged * gap + 5} r="20" />
  </g>
  <g class="shield">
    <path d="M1310 210 L1390 240 L1390 310 C 1390 360 1355 395 1310 415 C 1265 395 1230 360 1230 310 L1230 240 Z" />
    <path d="M1275 312 L1302 340 L1350 288" />
  </g>
</svg>
<style>
  .code { width: 100%; height: 100%; }
  .grid line { stroke: var(--art-line); opacity: 0.05; }
  .window rect { fill: rgb(0 0 0 / 0.28); stroke: var(--art-line); stroke-opacity: 0.55; stroke-width: 2.5; }
  .window line { stroke: var(--art-line); stroke-opacity: 0.3; stroke-width: 2; }
  .window circle { fill: var(--art-line); opacity: 0.45; }
  .gutter rect { fill: var(--art-line); opacity: 0.18; }
  .lines rect { fill: var(--art-line); opacity: 0.55; }
  .lines .hot { fill: var(--dot); opacity: 1; }
  .flag-bg { fill: var(--dot); opacity: 0.16; animation: flag 3s ease-in-out infinite; }
  .beam { animation: scan 5s cubic-bezier(.45,0,.55,1) infinite; }
  .beam rect { fill: var(--dot); opacity: 0.08; }
  .beam line { stroke: var(--dot); stroke-width: 3; filter: drop-shadow(0 0 8px var(--dot)); }
  .lens circle:first-child { fill: rgb(255 255 255 / 0.04); stroke: var(--art-line); stroke-width: 6; }
  .lens line { stroke: var(--art-line); stroke-width: 14; stroke-linecap: round; }
  .lens .ping { fill: var(--dot); transform-box: fill-box; transform-origin: center; animation: ping 2.4s ease-out infinite; }
  .shield path { fill: none; stroke: var(--dot); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 10px var(--dot)); }
  .shield path:first-child { fill: rgb(255 255 255 / 0.05); }
  @keyframes scan { 0% { transform: translateY(0); } 50% { transform: translateY(420px); } 100% { transform: translateY(0); } }
  @keyframes flag { 0%, 100% { opacity: 0.12; } 50% { opacity: 0.32; } }
  @keyframes ping { 0% { opacity: 0.9; transform: scale(0.5); } 80%, 100% { opacity: 0; transform: scale(3.2); } }
</style>
