---
import Wordmark from './Wordmark.astro';
import { footerLinks, nav, site, social } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Wordmark compact />
      <p class="tagline">{site.tagline}</p>
    </div>
    <nav aria-label="Sections">
      <h2 class="fh">Sections</h2>
      <ul>{nav.filter((n) => n.href !== '/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Publication">
      <h2 class="fh">The publication</h2>
      <ul>{footerLinks.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    {social.length > 0 && (
      <nav aria-label="Social">
        <h2 class="fh">Follow</h2>
        <ul>{social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}</ul>
      </nav>
    )}
  </div>
  <div class="wrap legal meta">
    <p>© {year} {site.name}. Written and edited by people; see how we use AI tools in our <a href="/editorial-policy/#ai">editorial policy</a>.</p>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--space-2xl); border-top: var(--border); background: var(--panel); padding-block: var(--space-xl) var(--space-m); }
  .grid { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .brand { display: grid; gap: var(--space-xs); align-content: start; }
  .tagline {  color: var(--ink-2); max-width: 22ch; }
  .fh { font: 600 var(--step-0) / 1.3 var(--font-sans); margin-bottom: var(--space-2xs); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  ul a { color: var(--ink-2); text-decoration: none; display: inline-block; padding: 0.2rem 0; }
  ul a:hover { color: var(--ink); text-decoration: underline; }
  .legal { margin-top: var(--space-xl); padding-top: var(--space-m); border-top: var(--border); }
</style>
