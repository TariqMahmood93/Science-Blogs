---
import { Image } from 'astro:assets';
import ContourArt from './ContourArt.astro';
import TypeMark from './TypeMark.astro';
import { articleUrl, formatDate, getLookups, readingTime, type Article } from '../lib/content';

interface Props {
  article: Article;
  variant?: 'feature' | 'standard' | 'text';
  headingLevel?: 'h2' | 'h3';
  showArt?: boolean;
}
const { article, variant = 'standard', headingLevel = 'h3', showArt = variant !== 'text' } = Astro.props;
const { data } = article;
const look = await getLookups();
const type = look.type(data.type.id)!;
const category = look.category(data.category.id)!;
const authors = data.authors.map((a) => look.author(a.id)?.data.name).filter(Boolean).join(' and ');
const minutes = readingTime(article.body);
const Heading = headingLevel;
const href = articleUrl(article);
---
<article class:list={['card', `card--${variant}`]}>
  {showArt && (
    <div class="art">
      {data.heroImage ? (
        <Image src={data.heroImage.src} alt="" widths={[400, 800, 1200]} sizes="(min-width: 60rem) 50vw, 100vw" class="img" />
      ) : (
        <ContourArt seed={article.id} tone={type.data.tone} ratio={variant === 'feature' ? '4/3' : '3/2'} />
      )}
    </div>
  )}
  <div class="body">
    <p class="kicker">
      <TypeMark type={type} />
      <a class="cat" href={`/topics/${category.id}/`}>{category.data.name}</a>
      {data.sample && <span class="sample-flag">Sample content</span>}
    </p>
    <Heading class="title"><a href={href}>{data.title}</a></Heading>
    {variant !== 'text' && <p class="dek">{data.dek}</p>}
    <p class="meta byline">
      <span>{authors}</span>
      <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
      <span>{minutes} min read</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  .art { overflow: hidden; border-radius: var(--radius-m); }
  .img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .body { display: grid; gap: var(--space-2xs); }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-s);
  }
  .cat {
    font-size: var(--step--1);
    color: var(--ink-2);
    text-decoration: none;
  }
  .cat:hover { text-decoration: underline; color: var(--ink); }
  .title {
    font-size: var(--step-2);
    line-height: 1.18;
  }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .dek {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  .card--feature .title { font-size: var(--step-4); line-height: 1.05; letter-spacing: -0.02em; }
  .card--feature .dek { font-size: var(--step-2); line-height: 1.35; max-width: 34ch; }
  @media (min-width: 56rem) {
    .card--feature {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-l);
      align-items: center;
    }
  }
  .card--text .title { font-size: var(--step-2); }
</style>
