---
import { Image } from 'astro:assets';
import ContourArt from './ContourArt.astro';
import TypeMark from './TypeMark.astro';
import { articleUrl, formatDate, getLookups, readingTime, type Article } from '../lib/content';

interface Props {
  article: Article;
  /** feature: large image beside text. standard: image above text. text: no image. */
  variant?: 'feature' | 'standard' | 'text';
  headingLevel?: 'h2' | 'h3';
  showArt?: boolean;
  showDek?: boolean;
}
const {
  article,
  variant = 'standard',
  headingLevel = 'h3',
  showArt = variant !== 'text',
  showDek = variant === 'feature',
} = Astro.props;
const { data } = article;
const look = await getLookups();
const type = look.type(data.type.id)!;
const category = look.category(data.category.id)!;
const authors = data.authors.map((a) => look.author(a.id)?.data.name).filter(Boolean).join(' and ');
const minutes = readingTime(article.body);
const Heading = headingLevel;
const href = articleUrl(article);
---
<article class:list={['card', `card--${variant}`]}>
  {showArt && (
    <div class="art">
      {data.heroImage ? (
        <Image src={data.heroImage.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 60rem) 50vw, 100vw" class="img" />
      ) : (
        <ContourArt seed={article.id} tone={type.data.tone} ratio="16/9" />
      )}
    </div>
  )}
  <div class="body">
    <p class="kicker">
      <a class="cat" href={`/topics/${category.id}/`}>{category.data.name}</a>
      <TypeMark type={type} />
    </p>
    <Heading class="title"><a href={href}>{data.title}</a></Heading>
    {showDek && <p class="dek">{data.dek}</p>}
    <p class="meta byline">
      <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
      <span>{minutes} min read</span>
      {variant === 'feature' && authors && <span>By {authors}</span>}
      {data.sample && <span class="sample-flag">Sample content</span>}
    </p>
    {variant === 'feature' && <p class="more"><a href={href} tabindex="-1" aria-hidden="true">Read the article</a></p>}
  </div>
</article>

<style>
  .card { position: relative; display: grid; gap: var(--space-s); align-content: start; }
  .art { overflow: hidden; border-radius: var(--radius-m); }
  .art :global(.contour), .img { transition: transform 0.4s ease; }
  .card:hover .art :global(.contour), .card:hover .img { transform: scale(1.025); }
  .img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { display: grid; gap: 0.55rem; }
  .kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem var(--space-s); }
  .cat {
    position: relative; z-index: 1;
    font: 600 var(--step--1) / 1.2 var(--font-sans);
    color: var(--accent); text-decoration: none;
  }
  .cat:hover { text-decoration: underline; }
  .kicker :global(.typemark) { position: relative; z-index: 1; font-weight: 500; }
  .title { font-size: 1.25rem; line-height: 1.25; font-weight: 650; letter-spacing: -0.015em; }
  .title a { color: var(--ink); text-decoration: none; }
  /* The whole card is clickable through the title link. */
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .title a:focus-visible::after { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: var(--radius-m); }
  .card:hover .title a { text-decoration: underline; text-decoration-thickness: 1px; }
  .dek { font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem var(--space-s); }

  .card--feature .title { font-size: var(--step-4); line-height: 1.06; letter-spacing: -0.03em; font-weight: 700; }
  .card--feature .dek { font-size: var(--step-1); max-width: 42ch; }
  .more { margin-top: var(--space-2xs); }
  .more a { font-weight: 600; }
  @media (min-width: 60rem) {
    .card--feature { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-xl); align-items: center; }
  }
  .card--text .title { font-size: 1.15rem; }
</style>
