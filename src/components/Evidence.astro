---
// Marks a passage as established evidence, interpretation, speculation or an open question.
import FillGlyph from './FillGlyph.astro';
type Kind = 'established' | 'interpretation' | 'speculation' | 'open';
interface Props { kind: Kind; title?: string }
const { kind, title } = Astro.props;
const meta: Record<Kind, { label: string; fill: number; dashed?: boolean; tone: string }> = {
  established: { label: 'Established evidence', fill: 1, tone: 'established' },
  interpretation: { label: 'Interpretation', fill: 0.5, tone: 'commentary' },
  speculation: { label: 'Speculation', fill: 0, tone: 'future' },
  open: { label: 'Open question', fill: 0, dashed: true, tone: 'idea' },
};
const m = meta[kind];
---
<aside class="evidence" style={`--tone: var(--tone-${m.tone})`} aria-label={m.label}>
  <p class="label"><FillGlyph fill={m.fill} dashed={m.dashed} size={16} /><span>{m.label}{title && <span class="t">: {title}</span>}</span></p>
  <div class="content"><slot /></div>
</aside>
<style>
  .evidence {
    margin-block: var(--space-m);
    padding: var(--space-s) var(--space-m);
    border-left: 4px solid var(--tone);
    background: var(--panel);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
  }
  .label { display: flex; align-items: center; gap: 0.45rem; font: 600 var(--step--1) / 1.3 var(--font-sans); color: var(--tone); margin: 0 0 var(--space-2xs); }
  .t { color: var(--ink); }
  .content :global(p) { margin: 0; }
  .content :global(p + p) { margin-top: var(--space-xs); }
</style>
