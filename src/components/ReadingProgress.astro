---
// Thin bar at the top of the window showing how far through the article the reader is.
interface Props { target: string }
const { target } = Astro.props;
---
<div class="progress" aria-hidden="true" data-progress-target={target}><span></span></div>
<script>
  const bar = document.querySelector<HTMLElement>('.progress');
  const el = bar && document.querySelector<HTMLElement>(bar.dataset.progressTarget!);
  if (bar && el) {
    const fill = bar.firstElementChild as HTMLElement;
    let ticking = false;
    const update = () => {
      const r = el.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      fill.style.transform = `scaleX(${p})`;
      bar.classList.toggle('on', r.top < 0 && p < 1);
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 50; pointer-events: none; opacity: 0; transition: opacity 0.2s; }
  .progress.on { opacity: 1; }
  .progress span { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
</style>
