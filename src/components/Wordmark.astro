---
// Typographic wordmark: a contour line meeting a horizon, then the name.
// Pass showName={false} to display the logo mark only; the name is still
// available to assistive tech via visually-hidden text.
interface Props { compact?: boolean; showName?: boolean }
const { compact = false, showName = true } = Astro.props;
---
<span class:list={['wordmark', { compact, 'mark-only': !showName }]}>
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M3 22.5 H29" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
    <path d="M6.5 22.5 C8 12 13 7.5 18.5 9 C23 10.2 24.5 15 25.5 22.5" stroke="currentColor" stroke-width="1.6" fill="none" />
    <path d="M11 22.5 C12 16 14.5 13.3 17.8 14 C20.4 14.6 21.2 18 21.6 22.5" stroke="currentColor" stroke-width="1.6" fill="none" opacity=".55" />
    <circle cx="18.6" cy="9" r="2.2" fill="var(--accent)" />
  </svg>
  {showName
    ? <span class="name"><span class="the">The</span> Research Frontier</span>
    : <span class="sr-only">The Research Frontier</span>
  }
</span>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .mark { width: 2rem; height: 2rem; flex: none; }
  .the { font-weight: 400; color: var(--ink-2); }
  .compact { font-size: 1.15rem; }
  .compact .mark { width: 1.6rem; height: 1.6rem; }
  .mark-only { gap: 0; }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
