---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListingHeader from '../../../components/ListingHeader.astro';
import ArticleGrid from '../../../components/ArticleGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import { site } from '../../../config/site';
import QuestionCard from '../../../components/QuestionCard.astro';
import { getCategories, getPublishedArticles, getQuestions, type Article, type Category } from '../../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const [cats, articles] = await Promise.all([getCategories(), getPublishedArticles()]);
  return cats.flatMap((category) =>
    paginate(articles.filter((a) => a.data.category.id === category.id), {
      params: { id: category.id },
      props: { category },
      pageSize: site.articlesPerPage,
    }),
  );
}) satisfies GetStaticPaths;
const { page, category } = Astro.props as { page: Page<Article>; category: Category };
const questions = page.currentPage === 1 ? (await getQuestions()).filter((q) => q.data.category.id === category.id) : [];
---
<BaseLayout title={category.data.name} description={category.data.description}>
  <ListingHeader title={category.data.name} intro={category.data.description}>
    <nav slot="above" class="meta crumbs" aria-label="Breadcrumb"><a href="/topics/">All topics</a></nav>
  </ListingHeader>
  <ArticleGrid articles={page.data} empty={`We haven't published anything in ${category.data.name} yet.`}>
    <Pagination page={page} />
  </ArticleGrid>
  {questions.length > 0 && (
    <section class="wrap tq" aria-labelledby="tq-h">
      <div class="section-head">
        <h2 id="tq-h">Open questions in {category.data.name}</h2>
        <a href={`/questions/?topic=${category.id}`}>All of them, with filters</a>
      </div>
      <div class="tq-grid">{questions.map((q) => <QuestionCard q={q} />)}</div>
    </section>
  )}
</BaseLayout>
<style>
  .crumbs a { color: var(--ink-2); }
  .tq { margin-top: var(--space-2xl); }
  .tq-grid { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
</style>
