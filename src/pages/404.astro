---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingHeader from '../components/ListingHeader.astro';
import { getCategories } from '../lib/content';
const categories = (await getCategories()).slice(0, 6);
---
<BaseLayout title="Page not found" noindex>
  <ListingHeader title="We couldn't find that page" intro="The link may be out of date, or the address mistyped. Search for what you were looking for, or start from a topic." />
  <div class="wrap nf">
    <form action="/search/" method="get" role="search" class="sf">
      <label for="nf-q" class="visually-hidden">Search articles</label>
      <input id="nf-q" name="q" type="search" placeholder="Search articles" />
      <button class="button" type="submit">Search</button>
    </form>
    <ul>{categories.map((c) => <li><a href={`/topics/${c.id}/`}>{c.data.name}</a></li>)}</ul>
    <p><a href="/">Go to the homepage</a></p>
  </div>
</BaseLayout>
<style>
  .nf { display: grid; gap: var(--space-m); }
  .sf { display: flex; gap: var(--space-2xs); max-width: 32rem; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  ul a { display: inline-block; padding: 0.4rem 0.8rem; border: var(--border); border-radius: 999px; text-decoration: none; color: var(--ink); }
</style>
