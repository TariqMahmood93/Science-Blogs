---
import PageLayout from '../layouts/PageLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../config/site';
---
<PageLayout title="Newsletter" description={`Get ${site.newsletter.cadence} from ${site.name}.`} intro={`${site.newsletter.cadence.charAt(0).toUpperCase() + site.newsletter.cadence.slice(1)}: new articles, one open research question explained, and the sources behind them.`}>
  <h2>What you'll get</h2>
  <ul>
    <li>Links to everything we've published that month, with a one-line summary of each.</li>
    <li>One open research question, explained in a few paragraphs.</li>
    <li>Corrections, if we've made any.</li>
  </ul>
  <h2>How we use your email</h2>
  <p>Only to send this newsletter. We never share or sell it, and every email has an unsubscribe link. Details are in the <a href="/privacy/#newsletter">privacy notice</a>.</p>
  <h2>Subscribe</h2>
  <div class="not-prose"><NewsletterForm id="page-newsletter" /></div>
</PageLayout>
<style>.not-prose { font-family: var(--font-sans); font-size: var(--step-0); }</style>
