---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AiNews from '../components/AiNews.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContourArt from '../components/ContourArt.astro';
import CoverArt from '../components/CoverArt.astro';
import EvidenceSpectrum from '../components/EvidenceSpectrum.astro';
import HeroArt from '../components/HeroArt.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { site } from '../config/site';
import { articleUrl, getCategories, getPublishedArticles, getQuestions } from '../lib/content';

const articles = await getPublishedArticles();
const categories = await getCategories();
const allQuestions = await getQuestions();
const founder = (await getCollection('authors')).find((a) => a.data.founder);

const featured = articles.find((a) => a.data.featured) ?? articles[0];
const secondary = articles.filter((a) => a.data.editorsPick && a !== featured).slice(0, 2);
const latest = articles.filter((a) => a !== featured && !secondary.includes(a)).slice(0, 9);
const spotlight = articles.find((a) => a.data.type.id === 'research-idea');
const questions = [...allQuestions.filter((q) => q.data.featured), ...allQuestions.filter((q) => !q.data.featured)].slice(0, 8);
const tabTopics = categories.filter((c) => latest.some((a) => a.data.category.id === c.id));

const counts = new Map<string, number>();
for (const a of articles) counts.set(a.data.category.id, (counts.get(a.data.category.id) ?? 0) + 1);
const qcounts = new Map<string, number>();
for (const q of allQuestions) qcounts.set(q.data.category.id, (qcounts.get(q.data.category.id) ?? 0) + 1);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
const topicMeta = (id: string) => {
  const parts = [counts.get(id) && plural(counts.get(id)!, 'article'), qcounts.get(id) && plural(qcounts.get(id)!, 'question')].filter(Boolean);
  return parts.length ? parts.join(', ') : 'Coming soon';
};
---
<BaseLayout>
  <section class="wrap intro" aria-labelledby="hero-h">
    <div class="intro-text">
      <h1 id="hero-h">Science, with the evidence showing.</h1>
      <p class="mission">
        Research explained in plain language, with every article clear about what is established, what is interpretation,
        and what is still open.
      </p>
    </div>
    <HeroArt />
  </section>

  <AiNews />

  {featured && (
    <section class="wrap featured" aria-label="Featured story">
      <ArticleCard article={featured} variant="feature" headingLevel="h2" />
    </section>
  )}

  {secondary.length > 0 && (
    <section class="wrap secondary" aria-label="Editors' selection">
      {secondary.map((a) => <ArticleCard article={a} headingLevel="h2" showDek />)}
    </section>
  )}

  <section class="wrap block" aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h">Latest articles</h2>
      <a class="button button--quiet" href="/articles/">View all articles</a>
    </div>
    {tabTopics.length > 1 && (
      <div class="tabs" role="group" aria-label="Filter latest articles by topic" data-tabs hidden>
        <button type="button" class="tab" data-topic="" aria-pressed="true">All</button>
        {tabTopics.map((c) => <button type="button" class="tab" data-topic={c.id} aria-pressed="false">{c.data.name}</button>)}
      </div>
    )}
    <div class="grid" data-tab-grid>
      {latest.map((a) => (
        <div class="cell" data-topic={a.data.category.id}><ArticleCard article={a} /></div>
      ))}
    </div>
    <p class="meta tab-status" role="status" aria-live="polite" data-tab-status></p>
  </section>

  {spotlight && (
    <section class="block band-dark spotlight" aria-labelledby="spot-h">
      <div class="wrap spot">
        <a class="spot-art" href={articleUrl(spotlight)} tabindex="-1" aria-hidden="true">
          {spotlight.data.cover ? <CoverArt kind={spotlight.data.cover} tone="idea" ratio="4/3" /> : <ContourArt seed={spotlight.id} tone="idea" ratio="4/3" />}
        </a>
        <div class="spot-text">
          <p class="spot-label">Research idea spotlight</p>
          <h2 id="spot-h"><a href={articleUrl(spotlight)}>{spotlight.data.title}</a></h2>
          {spotlight.data.researchQuestion && <p class="spot-q">{spotlight.data.researchQuestion}</p>}
          <p class="meta">A proposal for investigation, not an established result.</p>
          <p><a class="button" href={articleUrl(spotlight)}>Read the proposal</a> <a class="button button--quiet" href="/type/research-idea/">All research ideas</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="questions-band" aria-labelledby="questions-h">
    <div class="wrap">
      <div class="section-head qhead">
        <div>
          <h2 id="questions-h">Questions worth investigating</h2>
          <p class="qsub">Open problems, each explained: why it matters, what is known, and where researchers disagree.</p>
        </div>
        <div class="qnav" data-rail-controls hidden>
          <button type="button" class="rbtn" data-rail-prev aria-label="Previous questions">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="rbtn" data-rail-next aria-label="Next questions">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <ul class="rail" data-rail tabindex="0" aria-label="Research questions, scrollable">
        {questions.map((q) => <li><QuestionCard q={q} /></li>)}
        <li class="rail-end">
          <a href="/questions/">
            <span class="big">{allQuestions.length}</span>
            <span>See all research questions</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="topics-h">
    <div class="section-head">
      <h2 id="topics-h">Explore by discipline</h2>
      <a href="/topics/">All topics</a>
    </div>
    <ul class="topics">
      {categories.map((c) => (
        <li>
          <a href={`/topics/${c.id}/`}>
            <span class="tname">{c.data.name}</span>
            <span class="tdesc">{c.data.description}</span>
            <span class="tcount meta">{topicMeta(c.id)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block about" aria-labelledby="about-h">
    <div class="about-text">
      <h2 id="about-h">About the publication</h2>
      <p>
        {site.name} is an independent publication for readers who want rigorous ideas without jargon walls. We explain
        research, propose questions worth asking, and say clearly where the evidence stops.
      </p>
      <p>
        Articles are written and checked by people. We link to primary sources, correct mistakes in the open, and never
        present a hypothesis as a discovery. <a href="/editorial-policy/">Read our editorial policy</a>.
      </p>
      {founder && (
        <a class="founder" href="/about/">
          <span class="fmono" aria-hidden="true">{founder.data.initials}</span>
          <span><strong>{founder.data.name}</strong>, {founder.data.role?.toLowerCase()}. {founder.data.title}, University of Calabria.</span>
        </a>
      )}
    </div>
    <EvidenceSpectrum />
  </section>

  <section class="block band-dark newsletter" aria-labelledby="nl-h" id="newsletter">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap nl">
      <div>
        <h2 id="nl-h">Get the monthly letter</h2>
        <p class="lede">
          {site.newsletter.cadence.charAt(0).toUpperCase() + site.newsletter.cadence.slice(1)}: new articles, one open research
          question explained, and the sources behind them. We use your address only to send the newsletter, never share or
          sell it, and every email has an unsubscribe link.
        </p>
      </div>
      <NewsletterForm id="home-newsletter" />
    </div>
  </section>
</BaseLayout>

<script>
  // Topic tabs for the latest-articles grid.
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    tabs.hidden = false;
    const cells = [...document.querySelectorAll<HTMLElement>('[data-tab-grid] .cell')];
    const status = document.querySelector<HTMLElement>('[data-tab-status]')!;
    tabs.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.tab');
      if (!b) return;
      const topic = b.dataset.topic ?? '';
      let n = 0;
      cells.forEach((c) => { const show = !topic || c.dataset.topic === topic; c.hidden = !show; if (show) n++; });
      tabs.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      status.textContent = topic ? `Showing ${n} article${n === 1 ? '' : 's'} in ${b.textContent}.` : '';
    });
  }

  // Fade-in reveal for grid cells as they scroll into view. One-shot.
  const reveals = document.querySelectorAll<HTMLElement>('[data-tab-grid] .cell');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    reveals.forEach((el) => el.classList.add('reveal'));
    const ro = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); ro.unobserve(e.target); }
      }
    }, { threshold: 0.15 });
    reveals.forEach((el) => ro.observe(el));
  }

  // Question rail controls.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const controls = document.querySelector<HTMLElement>('[data-rail-controls]');
  if (rail && controls) {
    controls.hidden = false;
    const prev = controls.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-rail-next]')!;
    const step = () => (rail.querySelector('li')?.getBoundingClientRect().width ?? 300) + 24;
    const sync = () => {
      prev.disabled = rail.scrollLeft < 8;
      next.disabled = rail.scrollLeft + rail.clientWidth > rail.scrollWidth - 8;
    };
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  .block { margin-top: var(--space-2xl); }

  .intro {
    position: relative;
    display: grid;
    gap: var(--space-l) var(--space-xl);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-l);
    align-items: center;
  }
  .intro-text { display: grid; gap: var(--space-s); align-content: end; }
  @media (min-width: 60rem) { .intro { grid-template-columns: 1.25fr 1fr; } }
  .intro h1 { font-size: var(--step-5); line-height: 1; letter-spacing: -0.04em; font-weight: 700; max-width: 14ch; }
  .mission { font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); max-width: 38ch; }
  @media (max-width: 60rem) { .intro :global(.hero-art) { max-width: 320px; margin-inline: auto; } }

  .featured { padding-top: var(--space-m); border-top: var(--border); }
  .secondary {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .secondary :global(.title) { font-size: var(--step-2); line-height: 1.15; }

  .section-head h2 { font-size: var(--step-3); letter-spacing: -0.03em; }
  .tabs { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; margin-bottom: var(--space-l); scrollbar-width: none; }
  .tabs[hidden] { display: none; }
  .tab {
    flex: none; min-height: 2.5rem; padding: 0.4rem 1rem;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--panel); color: var(--ink);
    font: 500 var(--step--1) / 1.2 var(--font-sans); cursor: pointer;
  }
  .tab:hover { border-color: var(--rule-strong); }
  .tab[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .grid { display: grid; gap: var(--space-xl) var(--space-l); grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cell[hidden] { display: none; }
  .tab-status:empty { display: none; }
  .tab-status { margin-top: var(--space-m); }

  .spotlight { padding-block: var(--space-2xl); }
  .spot { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 56rem) { .spot { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); } }
  .spot-label { font-weight: 600; color: var(--tone-idea); font-size: var(--step--1); }
  .spot-text { display: grid; gap: var(--space-s); justify-items: start; }
  .spot h2 { font-size: var(--step-4); line-height: 1.05; letter-spacing: -0.035em; font-weight: 700; }
  .spot h2 a { color: var(--ink); text-decoration: none; }
  .spot h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .spot-q { font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); max-width: 46ch; }
  .spot-text > p:last-child { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-top: var(--space-2xs); }

  .questions-band { background: var(--panel); padding-block: var(--space-2xl); }
  .qhead { align-items: end; }
  .qsub { margin-top: var(--space-2xs); color: var(--ink-2); max-width: 50ch; }
  .qnav { display: flex; gap: var(--space-2xs); }
  .qnav[hidden] { display: none; }
  .rbtn {
    display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem;
    border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--paper); color: var(--ink); cursor: pointer;
  }
  .rbtn:hover:not(:disabled) { border-color: var(--ink); }
  .rbtn:disabled { opacity: 0.4; cursor: default; }
  .rail {
    list-style: none; margin: 0; padding: 0 0 var(--space-s);
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(16rem, 22rem); gap: var(--space-m);
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: thin;
  }
  .rail:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .rail > li { scroll-snap-align: start; display: grid; }
  .rail :global(.qcard) { background: var(--paper); }
  .rail-end a {
    display: grid; align-content: center; gap: var(--space-2xs); height: 100%; min-height: 12rem;
    padding: var(--space-m); border: 1px dashed var(--rule-strong); border-radius: var(--radius-m);
    color: var(--ink); text-decoration: none; font-weight: 600;
  }
  .rail-end a:hover { border-color: var(--ink); }
  .rail-end .big { font: 700 var(--step-5) / 1 var(--font-sans); letter-spacing: -0.04em; }

  .topics { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-s); grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .topics a {
    display: grid; gap: 0.35rem; height: 100%; padding: var(--space-m);
    border: var(--border); border-radius: var(--radius-m);
    color: var(--ink); text-decoration: none;
  }
  .topics a:hover { border-color: var(--ink); }
  .tname { font-weight: 650; font-size: var(--step-1); letter-spacing: -0.01em; }
  .tdesc { font-size: var(--step--1); color: var(--ink-2); line-height: 1.45; }
  .tcount { margin-top: 0.35rem; }

  .about { display: grid; gap: var(--space-xl); align-items: start; padding-top: var(--space-l); border-top: var(--border); }
  @media (min-width: 60rem) { .about { grid-template-columns: 1fr 1fr; } }
  .about-text { display: grid; gap: var(--space-s); font-size: var(--step-1); line-height: 1.55; max-width: 38rem; }
  .about-text h2 { font-size: var(--step-3); letter-spacing: -0.03em; }
  .founder { display: flex; align-items: center; gap: var(--space-s); margin-top: var(--space-2xs); font-size: var(--step-0); color: var(--ink); text-decoration: none; }
  .founder:hover strong { text-decoration: underline; }
  .fmono {
    flex: none; width: 3rem; height: 3rem; border-radius: 50%; border: 2px solid var(--ink);
    display: grid; place-items: center; font: 700 1.05rem/1 var(--font-sans); background: var(--paper);
  }

  .newsletter { position: relative; padding-block: var(--space-2xl); margin-bottom: calc(-1 * var(--space-2xl)); overflow: hidden; }
  .nl { position: relative; display: grid; gap: var(--space-l) var(--space-2xl); align-items: start; }
  @media (min-width: 56rem) { .nl { grid-template-columns: 1fr 1fr; } }
  .nl h2 { font-size: var(--step-4); letter-spacing: -0.035em; font-weight: 700; }
  .lede { margin-top: var(--space-s); font-size: var(--step-1); line-height: 1.55; color: var(--ink-2); max-width: 40ch; }
  .aurora {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.55;
    background:
      radial-gradient(60% 90% at 15% 20%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 60%),
      radial-gradient(55% 85% at 85% 80%, color-mix(in srgb, var(--tone-idea) 45%, transparent), transparent 60%),
      radial-gradient(80% 60% at 50% 50%, color-mix(in srgb, var(--tone-discovery) 25%, transparent), transparent 70%);
    filter: blur(28px);
    animation: aurora 18s ease-in-out infinite alternate;
  }
  @keyframes aurora {
    0%   { transform: translate3d(-3%, -2%, 0) scale(1.05); }
    50%  { transform: translate3d(2%, 1%, 0) scale(1.1); }
    100% { transform: translate3d(-1%, 3%, 0) scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) { .aurora { animation: none; } }

  /* Scroll-triggered reveal for the latest-articles grid. The class is only
     added by script, so a non-JS or reduced-motion visitor sees everything. */
  .cell.reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .cell.reveal.is-in { opacity: 1; transform: none; }
</style>
