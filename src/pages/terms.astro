---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site';
---
<PageLayout title="Terms of use" description={`Terms for using ${site.name}.`} intro="Plain terms for reading and sharing our work." updated="draft for review">
  <p><em>Draft. Review before launch; it is not legal advice.</em></p>
  <h2>Using our articles</h2>
  <p>You may read, link to and quote short passages from our articles with attribution and a link. For anything more, ask us first.</p>
  <h2>Not professional advice</h2>
  <p>Articles explain research for a general audience. They are not medical, legal, financial or security advice.</p>
  <h2>Links to other sites</h2>
  <p>We link to sources we think are useful but are not responsible for their content.</p>
  <h2>Changes</h2>
  <p>We may update these terms and will change the date at the top when we do.</p>
</PageLayout>
