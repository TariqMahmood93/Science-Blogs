# Public site URL, used for canonical links, sitemap and RSS.
SITE_URL=https://example.org

# "production" allows search engines to index the site. Any other value
# (or unset) adds noindex and a Disallow-all robots.txt — use for previews.
DEPLOY_ENV=

# Contact address shown on Contact, Corrections and Security pages.
PUBLIC_CONTACT_EMAIL=

# Newsletter provider's public signup form URL (the form "action").
# Leave empty to show "newsletter not yet enabled". Never put API keys here:
# every PUBLIC_ variable is visible in the browser.
PUBLIC_NEWSLETTER_ACTION=
# Name of the email field your provider expects (default: email).
PUBLIC_NEWSLETTER_EMAIL_FIELD=email
